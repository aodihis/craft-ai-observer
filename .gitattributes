# Files excluded from release archives / Composer dist packages
# (`.gitattributes` `export-ignore` — GitHub release archives and Composer
#  dist downloads honor these rules)
/docs/            export-ignore
/tests/           export-ignore
/.github/         export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
/composer.json    export-ignore
/composer.lock    export-ignore
/mago.toml        export-ignore
/.editorconfig    export-ignore

# PSR-12 requires LF line endings (F.1) — normalize on check-in
*.php              text eol=lf
*.md               text eol=lf
*.toml             text eol=lf
*.json             text eol=lf
*.yml              text eol=lf
*.yaml             text eol=lf