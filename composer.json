{
    "name": "craftcms/craft-ai-observer",
    "description": "Observer-agnostic telemetry library for laravel/ai agent activity (used by Craft CMS 6).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "craftcms",
        "laravel",
        "ai",
        "observability",
        "telemetry",
        "langfuse",
        "langsmith"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.4",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.60.2",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "CraftAiObserver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CraftAiObserver\\Dev\\Mago\\": "dev/mago/src/",
            "CraftAiObserver\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@lint",
            "@format:check",
            "@analyze",
            "@verify-rules",
            "@test"
        ],
        "lint": "mago lint",
        "lint:fix": "mago lint --fix",
        "format": "mago format",
        "format:check": "mago format --check",
        "analyze": "mago analyze",
        "verify-rules": "php dev/mago/verify.php",
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "CraftAiObserver\\ServiceProvider"
            ]
        }
    }
}
